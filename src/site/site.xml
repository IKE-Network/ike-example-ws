<site xmlns="http://maven.apache.org/SITE/2.0.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://maven.apache.org/SITE/2.0.0
      https://maven.apache.org/xsd/site-2.0.0.xsd"
      name="ike-example-ws">

    <skin>
        <groupId>org.sentrysoftware.maven</groupId>
        <artifactId>sentry-maven-skin</artifactId>
        <version>7.0.00</version>
    </skin>

    <custom>
        <bodyClass>sentry-green</bodyClass>
        <checkImageLinks>false</checkImageLinks>
        <convertImagesToWebp>false</convertImagesToWebp>
        <convertImagesToThumbnails>false</convertImagesToThumbnails>
        <setExplicitImageSize>false</setExplicitImageSize>
        <keywords>IKE, workspace, aggregator, ws goals, multi-repo,
                   integration test, IKE Network</keywords>
    </custom>

    <bannerLeft name="ike-example-ws" href="https://ike.network/">
        <image src="images/ike-logo.svg" alt="IKE"/>
    </bannerLeft>

    <bannerRight name="GitHub &lt;i class='fa-brands fa-github'&gt;&lt;/i&gt;"
        href="https://github.com/IKE-Network/ike-example-ws"/>

    <publishDate format="yyyy-MM-dd"/>

    <body>
        <breadcrumbs>
            <item name="IKE" href="https://ike.network/"/>
            <item name="ike-example-ws" href="index.html"/>
        </breadcrumbs>

        <links>
            <item name="GitHub" href="https://github.com/IKE-Network/ike-example-ws"/>
            <item name="Issues" href="https://github.com/IKE-Network/ike-issues"/>
        </links>

        <menu name="Documentation">
            <item name="Overview"                   href="index.html"/>
            <item name="workspace.yaml tour"        href="workspace-yaml.html"/>
            <item name="Software Bill of Materials" href="dependencies.html"/>
        </menu>

        <!-- Suppress the auto-injected Subprojects menu from
             doxia's default-site.xml. doxia-integration-tools
             ships a default-site.xml with <menu ref="modules"/>
             baked in; that menu gets merged into every site
             descriptor and triggers DefaultSiteTool.populateModulesMenu
             at render time, which iterates project.getModules()
             and appends relative-path <item>s. Without
             suppression, the sidebar renders two "Subprojects"
             sections — the auto one and the explicit one below.
             inheritAsRef="true" hits the early-return branch in
             populateModulesMenu (disassembly lines 43-56), so
             the populator skips items but the menu's header
             frame still renders. Sentry skin renders the header
             via $menu.name without a null guard; a missing name
             leaks "$menu.name" as literal text. name="" gives
             velocity an empty string to substitute (vs an
             unresolved variable). (#344) -->
        <menu name="" ref="modules" inheritAsRef="true"/>

        <menu name="Subprojects">
            <item name="doc-example"
                  href="https://ike.network/doc-example/"/>
            <item name="example-project"
                  href="https://ike.network/example-project/"/>
            <item name="ike-example-its (IT Suite)"
                  href="https://ike.network/ike-example-its/"/>
        </menu>


        <menu name="Foundation repos (consumed via Nexus)">
            <item name="ike-tooling"
                  href="https://ike.network/ike-tooling/"/>
            <item name="ike-docs"
                  href="https://ike.network/ike-docs/"/>
            <item name="ike-platform"
                  href="https://ike.network/ike-platform/"/>
        </menu>

        <menu name="Reference">
            <item name="IKE Network landing"
                  href="https://ike.network/"/>
            <item name="ws:* Goal Reference"
                  href="https://ike.network/ike-platform/ike-workspace-maven-plugin/ws-goals.html"/>
            <item name="Workspace Getting Started"
                  href="https://ike.network/ike-platform/workspace-getting-started.html"/>
        </menu>

        <menu name="Reports" ref="reports"/>
    </body>
</site>
