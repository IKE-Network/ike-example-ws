<?xml version="1.0" encoding="UTF-8"?>
<!--
  IKE Example Workspace

  Integration workspace for the five-repo split. Cloning this
  repo and running `mvn ws:init` pulls down ike-docs, ike-platform,
  doc-example, and example-project at the versions declared in
  workspace.yaml. Running `mvn clean install` then rebuilds the
  full cascade in dependency order.

  Every subproject is inside a file-activated profile so the reactor
  automatically includes only the repos that are physically cloned.

  Usage:
    mvn ws:init                              # Clone all repos
    mvn ws:overview                          # Workspace overview
    mvn clean install                        # All cloned repos
    mvn ws:release -DdryRun=true             # Preview release cascade
-->
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0
                             https://maven.apache.org/xsd/maven-4.1.0.xsd"
         root="true">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.platform</groupId>
        <artifactId>ike-parent</artifactId>
        <version>42</version>
        <relativePath/>
    </parent>

    <groupId>network.ike.examples</groupId>
    <artifactId>ike-example-ws</artifactId>
    <version>10-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>IKE Example Workspace</name>

    <profiles>

        <!-- ── Examples ──────────────────────────────────────────── -->
        <!-- Foundation repos (ike-tooling, ike-docs, ike-platform)    -->
        <!-- are intentionally NOT subprojects of this workspace; see  -->
        <!-- workspace.yaml for the rationale. They are consumed at    -->
        <!-- their released versions from Nexus.                       -->

        <profile>
            <id>with-doc-example</id>
            <activation>
                <file>
                    <exists>${project.basedir}/doc-example/pom.xml</exists>
                </file>
            </activation>
            <subprojects>
                <subproject>doc-example</subproject>
            </subprojects>
        </profile>

        <profile>
            <id>with-example-project</id>
            <activation>
                <file>
                    <exists>${project.basedir}/example-project/pom.xml</exists>
                </file>
            </activation>
            <subprojects>
                <subproject>example-project</subproject>
            </subprojects>
        </profile>

        <!-- ── Integration tests ─────────────────────────────────── -->
        <!-- The ITs live in their own repo (IKE-Network/ike-example-its,
             extracted in #343). They're cloned into ./its/ on demand
             via `mvn ws:init`. When present, the file-activated profile
             below picks them up as a workspace reactor module; when
             absent, the workspace builds without them. -->

        <profile>
            <id>with-its</id>
            <activation>
                <file>
                    <exists>${project.basedir}/its/pom.xml</exists>
                </file>
            </activation>
            <subprojects>
                <subproject>its</subproject>
            </subprojects>
        </profile>

    </profiles>

    <build>
        <plugins>
            <!-- Maven Site Plugin — wire asciidoctor-parser-doxia-module so
                 src/site/asciidoc/*.adoc actually renders at site:site time.
                 Without this, maven-site-plugin ignores .adoc files and the
                 generated index.html is the auto-generated "About" page.
                 Mirrors the fix #310 applied to ike-platform/ike-tooling.
                 The plugin <version> is intentionally omitted so the
                 inherited version from ike-parent's pluginManagement wins.
                 Once ike-parent picks up the same wiring (followup on #310)
                 this block can be removed. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <configuration>
                    <!-- Keep cross-repo absolute URLs in site.xml's
                         <links>, <menus>, and breadcrumbs as-is.
                         Defaults to true, which relativizes any
                         absolute link in the site descriptor
                         against project.url. Wrong for our cross-
                         repo links: each sibling repo publishes its
                         own gh-pages at https://ike.network/<repo>/
                         with no shared site-tree ancestor, so the
                         rebaser's relative math drops path
                         segments and produces 404s for
                         /ike-platform/... references. Setting
                         false keeps the URLs intact. -->
                    <relativizeSiteLinks>false</relativizeSiteLinks>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.asciidoctor</groupId>
                        <artifactId>asciidoctor-parser-doxia-module</artifactId>
                        <version>3.2.0</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

</project>
