<?xml version="1.0" encoding="UTF-8"?>
<!--
  IKE Example Workspace

  Integration workspace for the five-repo split. Cloning this
  repo and running `mvn ws:init` pulls down ike-docs, ike-platform,
  doc-example, and example-project at the versions declared in
  workspace.yaml. Running `mvn clean install` then rebuilds the
  full cascade in dependency order.

  Every subproject is inside a file-activated profile so the reactor
  automatically includes only the repos that are physically cloned.

  Usage:
    mvn ws:init                              # Clone all repos
    mvn ws:overview                          # Workspace overview
    mvn clean install                        # All cloned repos
    mvn ws:release -DdryRun=true             # Preview release cascade
-->
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0
                             https://maven.apache.org/xsd/maven-4.1.0.xsd"
         root="true">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.platform</groupId>
        <artifactId>ike-parent</artifactId>
        <version>152</version>
        <relativePath/>
    </parent>

    <groupId>network.ike.examples</groupId>
    <artifactId>workspace-reactor-example</artifactId>
    <version>25-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>IKE Workspace Reactor Example</name>

    <!-- Locally declared so the cascade's coordinate-to-repository
         lookup resolves a real repo URL, not the artifactId-appended
         path Maven would otherwise inherit from ike-parent (and in
         turn ike-base-parent). See IKE-Network/ike-issues#496. -->
    <scm>
        <connection>scm:git:https://github.com/IKE-Network/workspace-reactor-example.git</connection>
        <developerConnection>scm:git:git@github.com:IKE-Network/workspace-reactor-example.git</developerConnection>
        <url>https://github.com/IKE-Network/workspace-reactor-example</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- This is a worked example workspace, not a library.
             Override the Tier 0 default so ike:release-publish ships
             internally only (tag + Nexus + GitHub Release + gh-pages
             site) without publishing to Maven Central. Matches the
             three example subprojects (doc-example, project-example,
             integration-tests-example). Documented in ike-network-site
             index.adoc § Examples. -->
        <ike.publishToCentral>false</ike.publishToCentral>
        <!-- Examples tier — sentry-orange chrome per
             IKE-Network/ike-issues#545, #546. Distinguishes worked
             examples from foundation (sentry-green) under ike.network. -->
        <ike.site.deployment>ike-network-example</ike.site.deployment>
    </properties>

    <distributionManagement>
        <!-- Explicit <site> URL — declares the gh-pages publish location
             so site:stage relative-path computation matches reality.
             Previously inherited from ike-parent (whose URL template
             was tuned for external consumers); ike-issues#380 realigned
             ike-parent's template to in-reactor location, so external
             consumers like this workspace root must now declare their own. -->
        <site>
            <id>ike-site</id>
            <url>https://ike.network/${project.artifactId}/</url>
        </site>
    </distributionManagement>

    <subprojects>
        <subproject>doc-example</subproject>
        <subproject>project-example</subproject>
        <subproject>integration-tests-example</subproject>
    </subprojects>

    <build>
        <plugins>
            <!-- Maven Site Plugin — wire asciidoctor-parser-doxia-module so
                 src/site/asciidoc/*.adoc actually renders at site:site time.
                 Without this, maven-site-plugin ignores .adoc files and the
                 generated index.html is the auto-generated "About" page.
                 Mirrors the fix #310 applied to ike-platform/ike-tooling.
                 The plugin <version> is intentionally omitted so the
                 inherited version from ike-parent's pluginManagement wins.
                 Once ike-parent picks up the same wiring (followup on #310)
                 this block can be removed. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <configuration>
                    <!-- Keep cross-repo absolute URLs in site.xml's
                         <links>, <menus>, and breadcrumbs as-is.
                         Defaults to true, which relativizes any
                         absolute link in the site descriptor
                         against project.url. Wrong for our cross-
                         repo links: each sibling repo publishes its
                         own gh-pages at https://ike.network/<repo>/
                         with no shared site-tree ancestor, so the
                         rebaser's relative math drops path
                         segments and produces 404s for
                         /ike-platform/... references. Setting
                         false keeps the URLs intact. -->
                    <relativizeSiteLinks>false</relativizeSiteLinks>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.asciidoctor</groupId>
                        <artifactId>asciidoctor-parser-doxia-module</artifactId>
                        <version>3.2.0</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

</project>
