# Subprojects — cloned into this workspace by ws:scaffold-init.
# Each maintains its own .git — excluded from the workspace's git
# so Syncthing carries the tree but not nested Git internals.
/doc-example/
/project-example/
/integration-tests-example/

# ws:* report artifacts
checkpoints/
plan.yaml
ws꞉*.md
ike꞉*.md

# Stale gh-pages-style staging artifacts that have historically
# leaked from publishProjectSiteToGhPages into this main tree
# during cascade bumps. Canonical published content lives on each
# repo's gh-pages branch; never commit it here.
/examples/

# Claude Code (regenerated from ike-build-standards artifact)
.claude/
# BEGIN ike-managed
# IKE local state (never committed)
.ike/vcs-state
# END ike-managed

# ── Whitelist workspace-level files ──────────────────────────────
!.gitignore
!.gitattributes
!pom.xml
!workspace.yaml

# ── Whitelist workspace-owned directories ────────────────────────
!.mvn/
!.mvn/**
!checkpoints/
!checkpoints/**

# ── IntelliJ project config (curated slice) ──────────────────────
# Small, stable project-wide settings shared across collaborators.
# compiler.xml and vcs.xml are excluded — they regenerate per
# Maven reload or per workspace membership.
!.idea/
!.idea/.gitignore
!.idea/misc.xml
!.idea/kotlinc.xml
!.idea/encodings.xml
!.idea/jarRepositories.xml
